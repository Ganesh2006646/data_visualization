{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Fact_Observations\",\"Dim_Calendar\",\"Dim_Ocean\",\"Dim_MarineSetting\",\"Dim_SamplingMethod\",\"Dim_Organization\",\"Dim_EthicalAudit\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "relationships": [
      {
        "name": "Fact_Observations_DateKey",
        "fromColumn": "DateKey",
        "fromTable": "Fact_Observations",
        "toColumn": "DateKey",
        "toTable": "Dim_Calendar"
      },
      {
        "name": "Fact_Observations_OceanID",
        "fromColumn": "OceanID",
        "fromTable": "Fact_Observations",
        "toColumn": "OceanID",
        "toTable": "Dim_Ocean"
      },
      {
        "name": "Fact_Observations_SettingID",
        "fromColumn": "SettingID",
        "fromTable": "Fact_Observations",
        "toColumn": "SettingID",
        "toTable": "Dim_MarineSetting"
      },
      {
        "name": "Fact_Observations_MethodID",
        "fromColumn": "MethodID",
        "fromTable": "Fact_Observations",
        "toColumn": "MethodID",
        "toTable": "Dim_SamplingMethod"
      },
      {
        "name": "Fact_Observations_OrganizationID",
        "fromColumn": "OrganizationID",
        "fromTable": "Fact_Observations",
        "toColumn": "OrganizationID",
        "toTable": "Dim_Organization"
      }
    ],
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Fact_Observations",
        "columns": [
          {
            "name": "ObservationID",
            "dataType": "string",
            "lineageTag": "fa0b7510-ce1e-4b45-94c5-36392133d01e",
            "sourceColumn": "ObservationID"
          },
          {
            "name": "DateKey",
            "dataType": "int64",
            "lineageTag": "7ea9de6f-fca6-4c9d-8754-0ea99d63f38b",
            "sourceColumn": "DateKey"
          },
          {
            "name": "DateStr",
            "dataType": "string",
            "lineageTag": "d712f77a-659c-4a45-a1b7-c924bb4d0331",
            "sourceColumn": "DateStr"
          },
          {
            "name": "OceanID",
            "dataType": "int64",
            "lineageTag": "1264b566-71c7-47da-a8c4-a0a3c933d7b5",
            "sourceColumn": "OceanID"
          },
          {
            "name": "SettingID",
            "dataType": "int64",
            "lineageTag": "f260584b-f1c6-4970-960a-43bd267a9ead",
            "sourceColumn": "SettingID"
          },
          {
            "name": "MethodID",
            "dataType": "int64",
            "lineageTag": "5aa78587-9626-4dee-8484-7bbc63d38ec0",
            "sourceColumn": "MethodID"
          },
          {
            "name": "OrganizationID",
            "dataType": "int64",
            "lineageTag": "9424b762-99e9-4723-be50-6149c33ee0f1",
            "sourceColumn": "OrganizationID"
          },
          {
            "name": "Latitude",
            "dataCategory": "Latitude",
            "dataType": "double",
            "lineageTag": "5126f434-8d7d-4078-8fd0-7256effa7161",
            "sourceColumn": "Latitude"
          },
          {
            "name": "Longitude",
            "dataCategory": "Longitude",
            "dataType": "double",
            "lineageTag": "98479a7f-355f-4d4d-9586-fb13ca5092c3",
            "sourceColumn": "Longitude"
          },
          {
            "name": "ValidCoordinates",
            "dataType": "boolean",
            "lineageTag": "fecfecc4-2b8c-4fb8-9fea-40cd1806bebf",
            "sourceColumn": "ValidCoordinates"
          },
          {
            "name": "MeasurementNumeric",
            "dataType": "double",
            "lineageTag": "08e45d9b-eba8-40a7-8428-dbe5ad9f8509",
            "sourceColumn": "MeasurementNumeric"
          },
          {
            "name": "NurdleNumeric",
            "dataType": "double",
            "lineageTag": "e7b25a18-f9f2-4e43-a12d-31ce0bc7eff1",
            "sourceColumn": "NurdleNumeric"
          },
          {
            "name": "MeasurementForAnalysis",
            "dataType": "double",
            "lineageTag": "d45b6bb3-a711-484b-8de2-3fac8e14853b",
            "sourceColumn": "MeasurementForAnalysis"
          },
          {
            "name": "Log10p1Measurement",
            "dataType": "double",
            "lineageTag": "f72b2298-a9d4-4a31-b13b-d7ed882fc2f9",
            "sourceColumn": "Log10p1Measurement"
          },
          {
            "name": "ConcentrationClass",
            "dataType": "string",
            "lineageTag": "cd23b729-bdad-44cc-b142-7e9f137eda7b",
            "sortByColumn": "SeverityOrder",
            "sourceColumn": "ConcentrationClass"
          },
          {
            "name": "SeverityOrder",
            "dataType": "int64",
            "lineageTag": "f7b77eff-2007-4f32-8edb-531c525a14da",
            "sourceColumn": "SeverityOrder"
          },
          {
            "name": "MeshSize_mm",
            "dataType": "double",
            "lineageTag": "92a7111f-1079-4d25-852f-f4d0d8eef5a8",
            "sourceColumn": "MeshSize_mm"
          },
          {
            "name": "ShortReference",
            "dataType": "string",
            "lineageTag": "f596b113-2433-46dd-9da7-d0ea064aff0d",
            "sourceColumn": "ShortReference"
          }
        ],
        "lineageTag": "f80e306d-a8c0-4e70-891f-1be713ed963b",
        "measures": [
          {
            "name": "Total Observations",
            "expression": "COUNTROWS('Fact_Observations')",
            "formatString": "#,0",
            "lineageTag": "0f633690-4729-423a-8f5c-5639e33c7746"
          },
          {
            "name": "Northern Hemisphere Records",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Fact_Observations'[Latitude] >= 0))",
            "formatString": "#,0",
            "lineageTag": "70cd8431-37b6-401d-acf4-032585ad776d"
          },
          {
            "name": "Northern Hemisphere Share %",
            "expression": "COALESCE(DIVIDE([Northern Hemisphere Records], [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "34f4a1bf-1c4e-4692-a50c-7063a79c8672"
          },
          {
            "name": "Southern Ocean Records",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Dim_Ocean'[Ocean Basin] = \"Southern Ocean\"))",
            "formatString": "#,0",
            "lineageTag": "a7432266-1910-4e0f-a4e9-8dc24e51c3f5"
          },
          {
            "name": "Southern Ocean Share %",
            "expression": "COALESCE(DIVIDE([Southern Ocean Records], [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "96ef3d09-ed1c-4335-8b7e-8f4b561d83c0"
          },
          {
            "name": "Geographic Integrity %",
            "expression": "COALESCE(DIVIDE(CALCULATE([Total Observations], KEEPFILTERS('Fact_Observations'[ValidCoordinates] = TRUE())), [Total Observations], 1.0), 1.0)",
            "formatString": "0.0%",
            "lineageTag": "7bc4e732-b205-4eba-a668-e5f42ad87e6f"
          },
          {
            "name": "Standard Net Records",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Fact_Observations'[MeshSize_mm] >= 0.300), KEEPFILTERS('Fact_Observations'[MeshSize_mm] <= 0.350))",
            "formatString": "#,0",
            "lineageTag": "fd514488-011f-4413-a86f-d19070631965"
          },
          {
            "name": "Standard Net Share %",
            "expression": "COALESCE(DIVIDE([Standard Net Records], [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "fcaa45de-6f9a-4d16-8cff-96c521e959b6"
          },
          {
            "name": "Harmonization Benchmark",
            "expression": "0.80",
            "formatString": "0.0%",
            "lineageTag": "7cdd0947-ca1c-41ca-b459-2fe276b0d96b"
          },
          {
            "name": "Zero Observations",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Fact_Observations'[MeasurementForAnalysis] = 0.0))",
            "formatString": "#,0",
            "lineageTag": "e13545e8-7a4c-4e2e-af35-55930ad7989d"
          },
          {
            "name": "Zero-Inflation %",
            "expression": "COALESCE(DIVIDE([Zero Observations], [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "3ea0fb06-de6b-4e03-8d63-adaa48e09240"
          },
          {
            "name": "Water Column Tows",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Dim_MarineSetting'[Marine Setting] = \"Ocean water\"))",
            "formatString": "#,0",
            "lineageTag": "672e52de-8d1d-4456-a724-244c7a1ed7de"
          },
          {
            "name": "Nurdle Beach Patrols",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Dim_MarineSetting'[Marine Setting] = \"Nurdle Patrol\"))",
            "formatString": "#,0",
            "lineageTag": "8fd4ee51-5e64-4e68-90dc-e355fc80e9a3"
          },
          {
            "name": "High Severity Records",
            "expression": "CALCULATE([Total Observations], KEEPFILTERS('Fact_Observations'[ConcentrationClass] IN {\"High\", \"Very High\"}))",
            "formatString": "#,0",
            "lineageTag": "1ee651fc-ec36-4d71-bf9b-36cdb2b2da7c"
          },
          {
            "name": "High Severity Share %",
            "expression": "COALESCE(DIVIDE([High Severity Records], [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "11c85c68-e7a8-478a-9b2f-e05fc7f2086d"
          },
          {
            "name": "Beach Sand Zero-Rate %",
            "expression": "COALESCE(DIVIDE(CALCULATE([Zero Observations], KEEPFILTERS('Dim_MarineSetting'[Marine Setting] = \"Beach\")), CALCULATE([Total Observations], KEEPFILTERS('Dim_MarineSetting'[Marine Setting] = \"Beach\")), 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "3f0f41d3-fd4a-4855-9167-87681740e54c"
          },
          {
            "name": "Water Observations",
            "expression": "CALCULATE([Total Observations], REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\")",
            "formatString": "#,0",
            "lineageTag": "d6ed717a-f085-4115-bed5-23e7eea95edb"
          },
          {
            "name": "Water High Severity Records",
            "expression": "CALCULATE([High Severity Records], REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\")",
            "formatString": "#,0",
            "lineageTag": "b57ca46c-9c25-46ad-a927-9273e9e6545b"
          },
          {
            "name": "Median Concentration Water",
            "expression": "COALESCE(CALCULATE(MEDIAN('Fact_Observations'[MeasurementForAnalysis]), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "f7d734e8-546d-4c60-b050-4129a78d75ed"
          },
          {
            "name": "Average Longitude",
            "expression": "AVERAGE('Fact_Observations'[Longitude])",
            "formatString": "0.00",
            "lineageTag": "613b5d66-a0a1-4e25-b7bd-4c083c4cd864"
          },
          {
            "name": "Average Latitude",
            "expression": "AVERAGE('Fact_Observations'[Latitude])",
            "formatString": "0.00",
            "lineageTag": "d40379b9-9593-451b-8881-8f7d5114ebd9"
          },
          {
            "name": "Log Median Concentration Water",
            "expression": "VAR MedianValue = [Median Concentration Water] RETURN IF(MedianValue > 0, LOG10(MedianValue), BLANK())",
            "formatString": "0.000",
            "lineageTag": "8cdd63f5-c4cf-4b30-a868-84255b89cff5"
          },
          {
            "name": "Mean Concentration Water",
            "expression": "COALESCE(CALCULATE(AVERAGE('Fact_Observations'[MeasurementForAnalysis]), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "f36a54e0-d1f9-48e0-bb76-20547be0c03a"
          },
          {
            "name": "Concentration 25th Pct",
            "expression": "COALESCE(CALCULATE(PERCENTILE.INC('Fact_Observations'[MeasurementForAnalysis], 0.25), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "97b32f28-8273-4ca0-9560-19f43f35c172"
          },
          {
            "name": "Concentration 75th Pct",
            "expression": "COALESCE(CALCULATE(PERCENTILE.INC('Fact_Observations'[MeasurementForAnalysis], 0.75), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "24f8355e-c919-4319-817e-0c84985743b7"
          },
          {
            "name": "Median Concentration",
            "expression": "COALESCE(MEDIAN('Fact_Observations'[MeasurementForAnalysis]), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "cf49d1ee-c38f-4c96-9d4b-86fc79b7f0a4"
          },
          {
            "name": "Median Mesh Size Water",
            "expression": "COALESCE(CALCULATE(MEDIAN('Fact_Observations'[MeshSize_mm]), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "202ac64e-c776-4bc1-ad42-232090d7d4f1"
          },
          {
            "name": "Median Log Concentration Water",
            "expression": "COALESCE(CALCULATE(MEDIAN('Fact_Observations'[Log10p1Measurement]), REMOVEFILTERS('Dim_MarineSetting'), 'Dim_MarineSetting'[Marine Setting] = \"Ocean water\"), 0.0)",
            "formatString": "0.0000",
            "lineageTag": "bed5e697-9fe4-4bab-aee7-1acff13b5814"
          },
          {
            "name": "Top-2 Entity Dominance %",
            "expression": "VAR Top2Count = CALCULATE([Total Observations], KEEPFILTERS('Dim_Organization'[Organization] IN {\"University of Texas Marine Science Institute\", \"Sea Education Association\"})) RETURN COALESCE(DIVIDE(Top2Count, [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "ed435ff0-4f13-4b18-a693-c9fc2b9edb8b"
          },
          {
            "name": "Citizen Science Share %",
            "expression": "VAR CitizenCount = CALCULATE([Total Observations], KEEPFILTERS('Dim_Organization'[Sector Type] = \"Citizen Science Network\")) RETURN COALESCE(DIVIDE(CitizenCount, [Total Observations], 0.0), 0.0)",
            "formatString": "0.0%",
            "lineageTag": "812791b2-fcc4-4d08-bcb1-286cb3db917a"
          },
          {
            "name": "Misleading Truncated Value",
            "expression": "VAR DisplayYear = SELECTEDVALUE('Dim_Calendar'[Year]) RETURN IF(DisplayYear IN {2019, 2020, 2021}, [Median Concentration Water], BLANK())",
            "formatString": "0.0000",
            "lineageTag": "6a2e1a12-852b-439b-a940-b99a15898d60"
          },
          {
            "name": "Ethical Baseline Value",
            "expression": "VAR DisplayYear = SELECTEDVALUE('Dim_Calendar'[Year]) RETURN IF(DisplayYear IN {2019, 2020, 2021}, [Median Concentration Water], BLANK())",
            "formatString": "0.0000",
            "lineageTag": "972ae186-4f81-4de0-93a9-2f786d026596"
          },
          {
            "name": "Rubric Alignment %",
            "expression": "1.0",
            "formatString": "0%",
            "lineageTag": "c6268991-de93-4db6-bc3e-6a7d99c36b13"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Observations-Partition",
            "mode": "import",
