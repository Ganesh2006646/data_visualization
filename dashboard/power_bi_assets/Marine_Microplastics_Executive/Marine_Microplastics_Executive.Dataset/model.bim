              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"d:\\\\marine_microplastic_pollution_analytics\\\\dashboard\\\\power_bi_assets\\\\Fact_Observations.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
